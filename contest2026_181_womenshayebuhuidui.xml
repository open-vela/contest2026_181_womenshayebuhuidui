<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <!--
    Team overrides.

    The driver-level modules below carry upstream-bound fixes, so they keep
    pointing at our fork branches.

    The agent application (packages_ai_agent) is deliberately NOT taken from a
    fork: its full source is vendored in this repository under
    app/ai_agent_pkg/ and linked into packages/ai_agent, so a fresh
    `repo init` + `repo sync` builds the submitted application directly from the
    team repository, without depending on any public-repo PR being merged.
  -->
  <remote fetch="https://github.com/Sen70s/" name="team"/>

  <remove-project name="packages_ai_agent"/>

  <remove-project name="vendor_sifli"/>
  <project path="vendor/sifli" name="vendor_sifli" remote="team"
           revision="contest/pr-20261103"/>

  <remove-project name="external_zblue"/>
  <project path="external/zblue/zblue" name="external_zblue" remote="team"
           revision="contest/pr-20261103"/>

  <remove-project name="frameworks_bluetooth"/>
  <project path="frameworks/connectivity/bluetooth" name="frameworks_bluetooth" remote="team"
           revision="contest/pr-20261103"/>

  <project path="contest2026_181_womenshayebuhuidui" name="contest2026_181_womenshayebuhuidui">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_181_hello_app"/>
    <linkfile src="app/ai_agent" dest="packages/demos/contest2026_181_ai_agent"/>
    <linkfile src="app/ai_agent_pkg" dest="packages/ai_agent"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_181_hello_quickapp"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_181_board"/>
  </project>
</manifest>
