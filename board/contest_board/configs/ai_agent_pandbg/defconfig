# one prefix is silently discarded (the old 0x00020510 here never took effect;
# the build used the Kconfig default 0x00280704 instead).
# 0x002A0704 = Networking(0x020000) + Audio(0x200000) + Capturing(0x080000)
# + Wearable/Wristwatch(0x000704). Phones read the Networking bit to decide
# whether to offer tethering, so PAN needs it set.
CONFIG_CONFIG_BLUETOOTH_DEFAULT_COD=0x002A0704

