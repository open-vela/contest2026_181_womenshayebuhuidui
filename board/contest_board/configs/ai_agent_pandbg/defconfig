# R77: full BNEP Ethernet PDU in zblue global ACL pool (removes corrupt dedicated PAN pool)
# TX_MTU raised to 1691: acl_tx_pool is sized by BT_L2CAP_BUF_SIZE(TX_MTU),
# and BNEP data frames need up to 1691 bytes. The old comment about "never
# reads this symbol" was wrong — the pool uses it at compile time.
# CONFIG_BT_L2CAP_TX_MTU=1691  (set at line 233, no duplicate needed)
# A NAP peer may send us a full 1691-byte BNEP PDU. At the old 1025 the ACL
# reassembly buffer truncated large inbound frames, which shows up as stalled
# TCP downloads rather than an obvious error. 1695 = 1691 + 4 bytes of L2CAP
# header. Paired with RX_COUNT_EXTRA=2 above so the pool does not balloon.
CONFIG_BT_BUF_ACL_RX_SIZE=1695
# Class of Device. The Kconfig symbol is named CONFIG_BLUETOOTH_DEFAULT_COD,
